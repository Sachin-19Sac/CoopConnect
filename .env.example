# CoopConnect Environment Configuration

# Project Settings
PROJECT_NAME="CoopConnect"
VERSION="1.0.0"
API_PREFIX="/api"

# Database Configuration (PostgreSQL default, SQLite fallback for local demo)
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/coopconnect_db
DATABASE_URL="sqlite:///./coopconnect.db"

# Security & JWT Secrets
JWT_SECRET="coopconnect-super-secret-jwt-key-2026-sih"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo Mode
DEMO_MODE=True
